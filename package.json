{
  "name": "recallguard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,api -c cyan,magenta \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "vite",
    "dev:api": ".venv/bin/uvicorn api.index:app --reload --reload-dir api --port 8000",
    "setup:api": "python3 -m venv .venv && .venv/bin/pip install -r requirements-dev.txt",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.tests.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:api": ".venv/bin/python -m pytest api/tests -q",
    "ios": "vite build && cap sync ios && cap open ios",
    "ios:sync": "vite build && cap sync ios",
    "ios:run": "vite build && cap sync ios && cap run ios",
    "emulators": "node -e \"require('fs').mkdirSync('.emulator-data',{recursive:true})\" && npx --yes firebase-tools@15 emulators:start --project demo-recallguard --import .emulator-data --export-on-exit",
    "test:auth": "npx --yes firebase-tools@15 emulators:exec --only auth --project demo-recallguard \"vitest run --config vitest.firebase.config.ts tests/firebase/auth-emulator.test.ts\"",
    "test:rules": "npx --yes firebase-tools@15 emulators:exec --only firestore --project demo-recallguard \"vitest run --config vitest.firebase.config.ts tests/firebase/rules.test.ts\"",
    "test:firebase": "npx --yes firebase-tools@15 emulators:exec --only auth,firestore --project demo-recallguard \"vitest run --config vitest.firebase.config.ts\""
  },
  "dependencies": {
    "@capacitor-firebase/authentication": "^8.5.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/barcode-scanner": "^3.1.3",
    "@capacitor/camera": "^8.2.5",
    "@capacitor/core": "^8.5.3",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/share": "^8.0.3",
    "@hookform/resolvers": "^3.10.0",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@tanstack/react-query": "^5.104.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "firebase": "^13.0.0",
    "lucide-react": "^0.462.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.90.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.26.0",
    "rehype-sanitize": "^6.0.0",
    "sonner": "^1.7.4",
    "tailwind-merge": "^2.6.1",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.25.76",
    "zxing-wasm": "3.1.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@eslint/js": "^9.39.5",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.6.1",
    "concurrently": "^9.2.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^15.15.0",
    "postcss": "^8.5.30",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^5.4.0",
    "vitest": "^2.1.9"
  },
  "overrides": {
    "@capacitor-firebase/authentication": {
      "firebase": "$firebase"
    }
  }
}
