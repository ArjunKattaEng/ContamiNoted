# Copy to .env.local (git-ignored). VITE_* values are read at build time and are PUBLIC (bundled into
# the app); never put secrets in a VITE_ variable. Backend secrets can live here too (see api/.env.example).

# Absolute API origin for the iOS app, e.g. https://www.contaminoted.com (the web app uses relative /api)
VITE_API_BASE_URL=

# Backend: Gemini key for recall summaries (optional; see api/.env.example for all backend settings)
GEMINI_API_KEY=

# ---- Accounts (Firebase Auth + Firestore). Off unless VITE_ACCOUNTS=true ----
# Local testing with the emulators (no real Firebase project needed): run `npm run emulators`, then set
#   VITE_ACCOUNTS=true
#   VITE_USE_FIREBASE_EMULATORS=true
# (Development only: production and iOS builds ignore VITE_USE_FIREBASE_EMULATORS. Put these two lines in
# .env.development.local so `npm run build` / `npm run ios:sync` never pick them up.)
#
# Real project (Firebase console → Project settings → Your apps → Web app). These values are public: they
# identify the project and are safe in the app bundle. Security comes from firestore.rules.
VITE_ACCOUNTS=
VITE_USE_FIREBASE_EMULATORS=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
