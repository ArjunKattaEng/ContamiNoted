# Copy to .env.local (git-ignored). Vite reads these at build time.

# "mock" (synthetic data, default) or "api" (every service uses the backend)
VITE_DATA_SOURCE=mock

# With mock: services that already use the real backend (comma-separated). Live today: recalls
VITE_LIVE_SERVICES=recalls

# Absolute API origin for the iOS app, e.g. https://recallguard.vercel.app (the web app uses relative /api)
VITE_API_BASE_URL=
