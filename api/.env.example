# Copy to api/.env (git-ignored), or put these in the repo root .env.local. On Vercel, set them as
# project environment variables instead.

# Google Gemini: recall summaries. Without a key the API still works and returns no summaries.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# Used when the main model is overloaded (503) or rate-limited (429); leave empty to disable
GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest

# openFDA: optional, raises the rate limit from ~1,000 to 120,000 requests/day (https://open.fda.gov/apis/authentication/)
OPENFDA_API_KEY=

# Extra CORS origins, comma-separated (e.g. a custom domain). localhost and capacitor://localhost are always allowed.
ALLOWED_ORIGINS=
